{
  "name": "momentnest",
  "version": "0.4.36",
  "private": true,
  "license": "MIT",
  "description": "拾光匣：本地家庭相册、成长记忆与局域网原文件备份",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node ./node_modules/electron/install.js",
    "check:env": "node scripts/check-environment.mjs",
    "opensource:check": "node scripts/check-open-source.mjs",
    "dev": "npm run dev --workspace @momentnest/desktop",
    "build": "npm run build --workspace @momentnest/desktop",
    "typecheck": "npm run typecheck --workspace @momentnest/desktop",
    "preview": "npm run preview --workspace @momentnest/desktop",
    "desktop:test": "node --experimental-transform-types --test apps/desktop/test/*.test.ts",
    "desktop:ui:test": "node scripts/prepare-smoke.mjs && electron scripts/verify-desktop-ui.cjs",
    "desktop:layout:test": "node scripts/verify-desktop-layout.mjs",
    "models:setup": "node scripts/setup-models.mjs",
    "media:build": "node scripts/build-media-tools.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "package:test": "node --test scripts/test/*.test.mjs",
    "desktop:package": "npm run icons:build && npm run build && node scripts/package-desktop.mjs",
    "dev:web": "npm run dev:web --workspace @momentnest/desktop",
    "mobile:deps": "node scripts/mobile.mjs deps",
    "mobile:dev": "node scripts/mobile.mjs dev",
    "mobile:analyze": "node scripts/mobile.mjs analyze",
    "mobile:test": "node scripts/mobile.mjs test",
    "mobile:signing:init": "node scripts/create-android-signing.mjs",
    "mobile:apk": "npm run icons:build && node scripts/mobile.mjs apk",
    "mobile:apk:release": "npm run icons:build && node scripts/mobile.mjs apk-release",
    "mobile:apk:all": "npm run icons:build && node scripts/mobile.mjs apk-all"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
